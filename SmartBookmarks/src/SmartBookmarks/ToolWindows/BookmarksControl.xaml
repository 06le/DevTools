<UserControl x:Class="SmartBookmarks.ToolWindows.BookmarksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:SmartBookmarks.ToolWindows"
             Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:FolderNode}">
            <TextBlock FontWeight="SemiBold" Margin="2,6,2,2" Text="{Binding Title}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:BookmarkItemNode}">
            <StackPanel Margin="14,1,2,2">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Preview}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ToolBar DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Content="New Folder" Click="OnNewFolder" />
            <Button Content="Clear All" Click="OnClearAll" />
        </ToolBar>
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="8,4"
                   Opacity="0.8"
                   Text="Select bookmarks, then right-click Move to Folder." />
        <ListView x:Name="NodeList"
                  Margin="4"
                  BorderThickness="0"
                  ItemsSource="{Binding Nodes}"
                  SelectionMode="Extended"
                  MouseDoubleClick="OnMouseDoubleClick"
                  SelectionChanged="OnSelectionChanged"
                  PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
                  Background="Transparent"
                  Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
            <ListView.ContextMenu>
                <ContextMenu Opened="OnContextMenuOpened">
                    <MenuItem Header="Go To" Click="OnGoTo" />
                    <MenuItem Header="Rename" Click="OnRename" />
                    <MenuItem Header="Move to Folder" Name="MoveMenu" />
                    <Separator />
                    <MenuItem Header="Delete / Clear" Click="OnDelete" />
                    <MenuItem Header="Set as Default Folder" Click="OnSetDefaultFolder" />
                    <MenuItem Header="Rename Folder" Click="OnRenameFolder" />
                    <MenuItem Header="Delete Folder" Click="OnDeleteFolder" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </DockPanel>
</UserControl>
